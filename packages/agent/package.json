{
  "name": "@specsesh/agent",
  "version": "0.4.0",
  "description": "Agent Script as an authoring format, plus an interpreter over a declared subset of it, with pi, Claude Code, durable and Cloudflare hosts. Never compiles to the Salesforce runtime specification.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtaylorcpp/specsesh-agent.git",
    "directory": "packages/agent"
  },
  "exports": {
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring/index.js"
    },
    "./interpreter": {
      "types": "./dist/interpreter/index.d.ts",
      "import": "./dist/interpreter/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code/index.d.ts",
      "import": "./dist/claude-code/index.js"
    },
    "./durable": {
      "types": "./dist/durable/index.d.ts",
      "import": "./dist/durable/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "import": "./dist/cloudflare/index.js"
    },
    "./openspec": {
      "types": "./dist/openspec/index.d.ts",
      "import": "./dist/openspec/index.js"
    },
    "./task": {
      "types": "./dist/task/index.d.ts",
      "import": "./dist/task/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "agentscript-pi": "./dist/bin/agentscript-pi.js",
    "agentscript-durable": "./dist/bin/agentscript-durable.js",
    "agentscript-task": "./dist/bin/agentscript-task.js",
    "agentscript-change": "./dist/bin/agentscript-change.js"
  },
  "files": [
    "dist",
    "docs",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/task/scripts && cp src/task/scripts/*.agent dist/task/scripts/ && node scripts/chmod-bins.mjs && node scripts/check-assets.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.build.json && node scripts/chmod-bins.mjs",
    "test": "node scripts/check-subset-conformance.mjs && vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:claude-code": "vitest run --config vitest.live.config.ts __tests__/live/claude-code-tools.live.test.ts",
    "conformance": "node scripts/check-subset-conformance.mjs",
    "pack:check": "vitest run --config vitest.pack.config.ts"
  },
  "dependencies": {
    "@sf-agentscript/agentforce-dialect": "2.53.0",
    "@sf-agentscript/agentscript-dialect": "3.4.0",
    "@sf-agentscript/language": "3.2.3",
    "@sf-agentscript/parser-javascript": "3.1.3",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/chord": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-durable": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "agents": "^0.28.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.0.0",
    "agents": "0.28.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
