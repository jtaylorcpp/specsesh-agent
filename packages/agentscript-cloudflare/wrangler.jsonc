{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentscript-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "HOST", "class_name": "AgentScriptHost" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentScriptHost"] }]
}
