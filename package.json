{
  "name": "agentscript-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "pnpm -r check",
    "build": "pnpm --filter @specsesh/agent build",
    "test": "pnpm -r test",
    "agent": "node packages/agent/dist/bin/agentscript-pi.js",
    "durable": "node packages/agent/dist/bin/agentscript-durable.js",
    "pack:check": "node scripts/pack-check.mjs",
    "spec:check": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict",
    "spec:archive": "node scripts/spec-archive.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1"
  }
}
