---
title: Change build
---
flowchart LR
  build[runBuild<br/>change build]
  prepare[prepareBuild<br/>parse · refuse]
  refusal[buildRefusal<br/>stale or missing approvals]
  start[startChangeLoop<br/>agentscript.change-loop]
  next[next<br/>the next group, or the check]
  group[group<br/>a child group loop per group]
  check[change check<br/>changeChecks, then trial fold]
  trial[trialFold<br/>fold into a temp copy]
  answer[answerChangeEscalation<br/>reruns the blocked group or check]
  amend[applyAmendment<br/>amend-spec patch]
  startgroup[startGroupLoop<br/>task run on a group]
  gnext[group next<br/>the next unticked task]
  gtask[group task<br/>a child task loop]
  gcheck[group check<br/>the checks once more]
  gjudge[group judge<br/>group.agent]
  verdict[readGroupVerdict<br/>rework · ask · amend-spec]
  ganswer[answerGroupEscalation<br/>reruns the blocked task]
  taskloop[agentscript.task-loop<br/>one task]
  checks[runLoopChecks<br/>argv, no shell]

  build --> prepare
  prepare --> refusal
  build --> start
  build -->|amend-spec| amend
  start --> next
  next --> group
  group -->|child| gnext
  group -->|converged| next
  next -->|queue empty| check
  check --> checks
  check --> trial
  answer --> ganswer
  startgroup --> gnext
  gnext --> gtask
  gtask --> taskloop
  gtask --> gnext
  gnext -->|queue empty| gcheck
  gcheck --> checks
  gcheck --> gjudge
  gjudge --> verdict
  verdict -->|rework| gtask

