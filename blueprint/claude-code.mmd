flowchart LR
  port[createClaudeCodeReasoningPort<br/>one-shot, one claude -p per step]
  provider[claudeCodeProvider<br/>pi provider, no text streaming]
  args[claudeArgs<br/>safe-mode · json-schema · stream-json]
  env[claudeCodeEnv<br/>strips ANTHROPIC_API_KEY]
  spawn[spawnRunner<br/>fresh empty cwd per step]
  outcome[toClaudeCodeOutcome<br/>StepOutcome]
  session[ProviderSession<br/>held claude -p, calls to pi]
  sessions[SessionRegistry<br/>live sessions by id]
  bridge[ToolBridge<br/>agentscript MCP server]
  mcpbridge[mcpBridge<br/>loopback MCP server]
  runner[claudeCodeRunner<br/>one-task delegate, own file tools]

  port --> args
  port --> spawn
  port --> env
  port --> outcome
  port -->|tools| bridge
  provider --> args
  provider --> spawn
  provider -->|tool offers + bridge| session
  session --> sessions
  session --> bridge
  bridge -.->|made by| mcpbridge
  runner --> env

