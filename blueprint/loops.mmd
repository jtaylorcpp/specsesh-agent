---
title: OpenSpec workflow
---
flowchart LR
  draftcmd[change draft<br/>runDraft]
  approvecmd[change approve<br/>runApprove]
  buildcmd[change build<br/>runBuild]
  closecmd[change close<br/>runClose]
  taskrun[task run<br/>a task or a group]
  specrun[task spec<br/>one stage]
  pickcmd[task pick-tests<br/>pickTests]
  draftloop[agentscript.draft-loop<br/>every unapproved stage]
  specloop[agentscript.spec-loop<br/>draft one stage, gate it]
  changeloop[agentscript.change-loop<br/>every group, then the change check]
  grouploop[agentscript.group-loop<br/>tasks in order, then the group check]
  taskloop[agentscript.task-loop<br/>one task until its checks pass]
  run[agentscript.run<br/>one script run]
  interp[interpreter run<br/>ci-test-pick.agent, not durable]
  approvals[approvals.json<br/>recordApproval]
  tasksmd[tasks.md<br/>tickTask]
  trial[trialFold<br/>fold into a temp copy]
  openspec[runOpenspec<br/>validate · archive]
  ontology[OpenSpec ontology<br/>Iteration · Evidence · Approval]

  draftcmd --> draftloop
  approvecmd -->|approve| draftloop
  draftloop -->|per stage| specloop
  specrun --> specloop
  specloop -->|per iteration| run
  specloop --> approvals
  buildcmd --> changeloop
  changeloop -->|per group| grouploop
  taskrun --> grouploop
  taskrun --> taskloop
  grouploop -->|per task| taskloop
  taskloop -->|per iteration| run
  taskloop --> tasksmd
  changeloop --> trial
  closecmd --> trial
  closecmd -->|archive| openspec
  trial --> openspec
  pickcmd --> interp
  taskloop -->|records| ontology
  specloop -->|records| ontology

