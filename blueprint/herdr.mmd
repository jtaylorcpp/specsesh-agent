  status[OSC 7501 status · planned<br/>idle · working · done · error · app=specsesh]
  panel[tuning panel · planned<br/>Herdr mod · edit, check, save, rerun]
  templates[hc templates · planned<br/>agents start sessions as sub-agents]
  answers[answers in the terminal · later<br/>a blocked loop waits for the principal]
  hcrunner[hc runner · later<br/>an agent delegate in its own terminal]
  catalog[catalog<br/>bundled and delegate scripts]
  contract[delegate contract<br/>instructions in · ok · summary out]
  run[agentscript.run<br/>a durable run of one script]
  watch[watchScript<br/>a durable run as RunEvents]
  loopevents[LoopWatcher<br/>loop events from the checkpoint]
  answer[answerEscalation<br/>a new run of the blocked loop]
  agentrunner[agent runner<br/>a script as a durable child run]

