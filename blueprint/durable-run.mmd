---
title: Durable run
---
flowchart LR
  runscript[runScript<br/>start + wait]
  startscript[startScript<br/>create an agentscript.run task]
  wait[waitForScript<br/>the run's result]
  watch[watchScript<br/>a run as RunEvents]
  harness[createAgentHarness<br/>models · registry · runners]
  ext[agentScriptExtensions<br/>AgentScript task + step extension]
  bind[checkBindings<br/>refuse unbound actions at start]
  next[next<br/>step machine next]
  dispatch[dispatch<br/>child conversation per step]
  await[await<br/>submit · wait · apply]
  submit[checkResult<br/>submit_result, 3rd refusal fails]
  act[act<br/>run one host action]
  registry[createActionRegistry<br/>host actions by name]
  toolhost[registryHost<br/>registry for one-shot runs]
  ws[workspaceActions<br/>read · write · list · search · exec]
  mem[memoryWorkspace<br/>in memory]
  local[localWorkspace<br/>a directory on disk]
  builtins[builtinActions<br/>argv commands]
  deleg[delegationActions<br/>granted delegates only]
  grants[validateGrants<br/>DelegateGrantError]
  runners[defaultRunners<br/>agent · claude-code]
  agentrun[agentRunner<br/>our script as a child run]
  scripts[READ_AGENT · EDIT_AGENT<br/>bundled delegate scripts]
  ccrun[claudeCodeRunner<br/>claude -p in the workspace]
  mcptools[mcpTools<br/>server/tool actions]

  runscript --> startscript
  runscript --> wait
  startscript --> ext
  watch --> ext
  harness --> ext
  harness --> registry
  harness --> grants
  ext --> bind
  ext --> next
  next -->|reason| dispatch
  dispatch --> await
  await --> submit
  await --> next
  next -->|action| act
  act --> registry
  act --> next
  toolhost --> registry
  registry --> ws
  registry --> builtins
  registry --> deleg
  registry --> mcptools
  ws --> mem
  ws --> local
  deleg --> grants
  deleg --> runners
  runners --> agentrun
  runners --> ccrun
  agentrun --> scripts
  agentrun -.->|child agentscript.run| ext

