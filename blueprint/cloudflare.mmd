flowchart LR
  worker[Worker fetch<br/>example: routes to the DO]
  faux[FauxAgentScriptHost<br/>example: AGENTSCRIPT_FAUX]
  fauxagent[FauxAgentHost<br/>example: defineAgentHost]
  host[AgentScriptHost<br/>Durable Object, Workers AI]
  define[defineAgentHost<br/>DO class from an AgentConfig]
  routes[handleRunRoutes<br/>start a run · read a run]
  harness[createAgentHarness<br/>inside PiHarness]
  workersai[workersAI<br/>ModelFactory on the AI binding]
  runners[defaultCloudflareRunners<br/>agent only, no claude-code]
  sandbox[sandboxWorkspace<br/>Sandbox exec · git · publish]
  redact[redactor<br/>secrets as ***]
  artifacts[artifactsSandboxWorkspace<br/>fork per task · clone]

  worker --> faux
  worker --> fauxagent
  faux -.->|extends| host
  fauxagent -.->|built by| define
  host --> routes
  define --> routes
  define --> harness
  define --> workersai
  define --> runners
  harness -.->|config workspace| sandbox
  sandbox --> redact
  artifacts --> sandbox

