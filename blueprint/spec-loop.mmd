  answerspec[answerSpecLoop<br/>principal only]
  iterate[iterate<br/>seed the contract, child run]
  run[agentscript.run<br/>the stage script, once]
  await[await<br/>the settled child by id]
  write[write<br/>owned sections to disk]
  bundle[readBundle<br/>one section per path]
  gate[gate<br/>the stage's gate, no model]
  approve[approve<br/>record it, draft nothing]
  approvals[recordApproval<br/>approvals.json]

