flowchart LR
  run[run<br/>one-shot loop, not durable]
  stream[streamRun<br/>RunEvents as they happen]
  start[start<br/>RunState from source]
  analyze[analyze<br/>parse + lint diagnostics]
  doc[Document<br/>mutate · undo · redo]
  scan[scanDocument<br/>refuse constructs outside the subset]
  subset[SUPPORTED_CONSTRUCTS<br/>the declared subset]
  next[next<br/>pure: step · action · done]
  compose[compose<br/>system block · prompt · logic lines]
  offers[composeToolOffers<br/>tools · output schema]
  actions[readActionDefinitions<br/>actions and run clauses]
  evaluate[evaluate<br/>expressions · templates]
  port[ReasoningPort<br/>reason a step]
  host[RunOptions.actions<br/>the host's action host]
  apply[apply<br/>outcome into state]
  catalog[Script catalog<br/>bundled · delegate · examples]

  stream --> run
  catalog -->|source| start
  run --> start
  run --> next
  run --> apply
  start -->|analyze| analyze
  doc --> analyze
  start --> scan
  scan --> subset
  next --> compose
  compose --> evaluate
  compose --> offers
  offers --> actions
  next -->|awaiting step| port
  next -->|awaiting action| host
  port -->|StepOutcome| apply
  host -->|ActionResult| apply
  apply -->|logic lines| evaluate
  apply --> next

