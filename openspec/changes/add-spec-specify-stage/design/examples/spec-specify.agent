config:
    agent_name: "spec-specify"
    description: "Derives the spec deltas of one OpenSpec change from its approved proposal and design"

system:
    instructions: |
        You write the spec deltas of one OpenSpec change from its approved proposal and design.
        Requirements are low level: concrete, testable values, RFC 2119 SHALL, each with
        #### Scenario: blocks. Everything the design shows is either pinned by a requirement or
        listed as out of scope in the proposal. Never add behaviour the design does not show.

variables:
    change_id: mutable string = ""
        description: "the change's id"
    stage: mutable string = ""
        description: "always specs"
    intent: mutable string = ""
        description: "the principal's words"
    approved: mutable string = ""
        description: "the approved proposal and design, as a === bundle"
    current: mutable string = ""
        description: "the deltas as they are now, as a === bundle"
    base: mutable string = ""
        description: "the current spec of each modified capability"
    iteration: mutable number = 1
        description: "which draft this is"
    carried: mutable string = ""
        description: "the gate's issues, or what the principal asked for"
    files: mutable string = ""
        description: "the drafted deltas, each opened by a line === specs/<area>/<name>/spec.md"
    summary: mutable string = ""
        description: "what this draft changed"
    next_action: mutable string = "review"
        description: "review or ask"
    question: mutable string = ""
        description: "the question when next_action is ask"

subagent draft:
    description: "Draft every delta"

    reasoning:
        instructions: ->
            | Change {!@variables.change_id}. The approved proposal and design:
            | {!@variables.approved}
            | Current specs of the capabilities it modifies:
            | {!@variables.base}
            if @variables.iteration > 1:
                | The deltas as they are now:
                | {!@variables.current}
                | Fix every one of these before anything else:
                | {!@variables.carried}
            | Write one delta per capability the proposal names, and no other, as === specs/<area>/<name>/spec.md.
            | A new capability starts with ## Purpose. A MODIFIED requirement is copied whole, every scenario included; rename a scenario only through REMOVED plus ADDED. Keep each requirement's text under 500 characters.
            | Stay within six requirements and sixteen scenarios in all.
            | Answer next_action with exactly one word: review, or ask when only the principal can choose. Put the question in question.
            set @variables.files = @outputs.files
            set @variables.summary = @outputs.summary
            set @variables.next_action = @outputs.next_action
            set @variables.question = @outputs.question
