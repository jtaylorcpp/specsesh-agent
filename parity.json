{
  "providers": ["api-keys", "claude-code", "gemini", "ollama", "workers-ai"],
  "features": [
    {
      "id": "one-shot",
      "label": "One-shot run (`agent run`, `run()`)",
      "cells": {
        "api-keys": { "value": "tested", "evidence": [{ "test": "answers a text-only step and completes" }] },
        "claude-code": { "value": "tested", "evidence": [{ "test": "Scenario: A completed run prints its steps and usage" }] },
        "gemini": { "value": "tested", "evidence": [{ "test": "Scenario: A script runs on Gemini" }] },
        "ollama": { "value": "tested", "evidence": [{ "test": "Scenario: A script runs on a pulled ollama model" }] },
        "workers-ai": { "value": "no" }
      }
    },
    {
      "id": "durable",
      "label": "Durable run",
      "cells": {
        "api-keys": { "value": "tested", "evidence": [{ "test": "Scenario: A two-model-step script walks the phases in order" }] },
        "claude-code": { "value": "tested", "evidence": [{ "test": "Scenario: A durable claude-code run calls a --tools tool" }] },
        "gemini": { "value": "tested", "evidence": [{ "test": "Scenario: A durable run completes on Gemini" }] },
        "ollama": { "value": "tested", "evidence": [{ "test": "Scenario: A durable run completes on a pulled ollama model" }] },
        "workers-ai": { "value": "no", "note": "the Node durable command; on Cloudflare every run is durable (see the Cloudflare row)" }
      }
    },
    {
      "id": "resume",
      "label": "Crash, then resume",
      "cells": {
        "api-keys": { "value": "tested", "evidence": [{ "test": "Scenario: A crash during the second model request resumes at the second step" }] },
        "claude-code": { "value": "tested", "evidence": [{ "test": "Scenario: A claude-code run killed during a tool call resumes" }] },
        "gemini": { "value": "tested", "evidence": [{ "test": "Scenario: A crashed Gemini run finishes on resume" }] },
        "ollama": { "value": "tested", "evidence": [{ "test": "Scenario: A crashed ollama run finishes on resume" }] },
        "workers-ai": { "value": "untested" }
      }
    },
    {
      "id": "task",
      "label": "Task and change loops",
      "cells": {
        "api-keys": { "value": "tested", "evidence": [{ "test": "Scenario: A converged loop prints its iterations and ticked" }] },
        "claude-code": {
          "value": "live",
          "evidence": [
            { "test": "Scenario: The live run converges and ticks the task" },
            { "test": "Scenario: A live group converges" }
          ]
        },
        "gemini": { "value": "tested", "evidence": [{ "test": "Scenario: A task loop converges on Gemini" }] },
        "ollama": { "value": "tested", "evidence": [{ "test": "Scenario: A task loop converges on a pulled ollama model" }] },
        "workers-ai": { "value": "no" }
      }
    },
    {
      "id": "cloudflare",
      "label": "Cloudflare Durable Object host",
      "cells": {
        "api-keys": {
          "value": "tested",
          "note": "on a faux model under `wrangler dev --local`",
          "evidence": [
            { "script": "examples/cloudflare-worker/test/crash-resume.sh" },
            { "script": "examples/cloudflare-worker/test/routes.sh" }
          ]
        },
        "claude-code": { "value": "no" },
        "gemini": { "value": "untested", "note": "`defineAgentHost` takes any model; no test runs Gemini in a Worker" },
        "ollama": { "value": "no" },
        "workers-ai": { "value": "untested", "note": "the binding adapter is tested on a fake binding; no Durable Object run" }
      }
    },
    {
      "id": "structured",
      "label": "Structured steps",
      "cells": {
        "api-keys": { "value": "tested", "evidence": [{ "test": "Scenario: A structured step offers the result tool" }] },
        "claude-code": { "value": "tested", "evidence": [{ "test": "Scenario: A schema and a turn bound are appended in order" }] },
        "gemini": { "value": "tested", "evidence": [{ "test": "Scenario: A forced function call becomes the structured result" }] },
        "ollama": { "value": "tested", "evidence": [{ "test": "Scenario: A forced tool call becomes the structured result" }] },
        "workers-ai": { "value": "untested" }
      }
    },
    {
      "id": "tools",
